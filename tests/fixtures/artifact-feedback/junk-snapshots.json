{
  "description": "Each case patches a deep copy of snapshot.json at a dotted path ('' replaces the whole value; a value of {\"$delete\": true} removes the key). Every case must be rejected whole by the comments client (rebuild returns null). Cases needing NaN, getters or class instances live in the test file because JSON cannot express them.",
  "cases": [
    { "name": "snapshot is a string", "patches": [{ "path": "", "value": "not a snapshot" }] },
    { "name": "snapshot is null", "patches": [{ "path": "", "value": null }] },
    { "name": "snapshot is an array", "patches": [{ "path": "", "value": [] }] },
    { "name": "comments is not an array", "patches": [{ "path": "comments", "value": { "0": {} } }] },
    { "name": "storeId empty", "patches": [{ "path": "storeId", "value": "" }] },
    { "name": "storeId contains a path separator", "patches": [{ "path": "storeId", "value": "../x" }] },
    { "name": "revision negative", "patches": [{ "path": "revision", "value": -1 }] },
    { "name": "revision fractional", "patches": [{ "path": "revision", "value": 1.5 }] },
    { "name": "revision is a string", "patches": [{ "path": "revision", "value": "7" }] },
    { "name": "health unknown", "patches": [{ "path": "health", "value": "weird" }] },
    { "name": "notice is an object", "patches": [{ "path": "notice", "value": { "a": 1 } }] },
    { "name": "foreignCount negative", "patches": [{ "path": "foreignCount", "value": -2 }] },
    { "name": "comment is null", "patches": [{ "path": "comments.0", "value": null }] },
    { "name": "comment is an array", "patches": [{ "path": "comments.0", "value": [] }] },
    { "name": "status unknown", "patches": [{ "path": "comments.0.status", "value": "done" }] },
    { "name": "provenance unknown", "patches": [{ "path": "comments.0.provenance", "value": "trusted" }] },
    { "name": "id has the wrong prefix", "patches": [{ "path": "comments.0.id", "value": "sel_0123456789abcdef0123456789abcdef" }] },
    { "name": "id is a path traversal", "patches": [{ "path": "comments.0.id", "value": "cmt_../../../../etc/passwd" }] },
    { "name": "id contains NUL", "patches": [{ "path": "comments.0.id", "value": "cmt_0123456789abcdef0123456789abcde\u0000" }] },
    { "name": "id upper-case hex", "patches": [{ "path": "comments.0.id", "value": "cmt_0123456789ABCDEF0123456789ABCDEF" }] },
    { "name": "id does not derive from selectionId", "patches": [{ "path": "comments.0.id", "value": "cmt_ffffffffffffffffffffffffffffffff" }] },
    { "name": "selectionId malformed", "patches": [{ "path": "comments.0.selectionId", "value": "sel_short" }] },
    { "name": "ordinal zero", "patches": [{ "path": "comments.0.ordinal", "value": 0 }] },
    { "name": "ordinal fractional", "patches": [{ "path": "comments.0.ordinal", "value": 1.5 }] },
    { "name": "version zero", "patches": [{ "path": "comments.0.version", "value": 0 }] },
    { "name": "kind not a string", "patches": [{ "path": "comments.0.kind", "value": 7 }] },
    { "name": "kind malformed", "patches": [{ "path": "comments.0.kind", "value": "Pin<script>" }] },
    { "name": "text empty", "patches": [{ "path": "comments.0.text", "value": "" }] },
    { "name": "text not a string", "patches": [{ "path": "comments.0.text", "value": 5 }] },
    { "name": "createdAt not ISO", "patches": [{ "path": "comments.0.createdAt", "value": "yesterday" }] },
    { "name": "createdAt without Z", "patches": [{ "path": "comments.0.createdAt", "value": "2026-11-12T10:00:00.000+02:00" }] },
    { "name": "sentAt not null or ISO", "patches": [{ "path": "comments.0.sentAt", "value": 12345 }] },
    { "name": "artifactRevision negative", "patches": [{ "path": "comments.0.artifactRevision", "value": -3 }] },
    { "name": "viewSessionId empty", "patches": [{ "path": "comments.0.viewSessionId", "value": "" }] },
    { "name": "hasScreenshot not boolean", "patches": [{ "path": "comments.0.hasScreenshot", "value": "yes" }] },
    { "name": "label not a string", "patches": [{ "path": "comments.0.label", "value": null }] },
    { "name": "anchor missing", "patches": [{ "path": "comments.0.anchor", "value": { "$delete": true } }] },
    { "name": "anchor tag upper-case", "patches": [{ "path": "comments.0.anchor.tag", "value": "BUTTON" }] },
    { "name": "anchor route over 512", "patches": [{ "path": "comments.0.anchor.route", "value": "REPEAT:/:513" }] },
    { "name": "anchor selector over 512", "patches": [{ "path": "comments.0.anchor.selector", "value": "REPEAT:a:513" }] },
    { "name": "four selector alternates", "patches": [{ "path": "comments.0.anchor.selectorAlternates", "value": ["a", "b", "c", "d"] }] },
    { "name": "alternate not a string", "patches": [{ "path": "comments.0.anchor.selectorAlternates", "value": [1] }] },
    { "name": "textAnchor text over 80", "patches": [{ "path": "comments.0.anchor.textAnchor.text", "value": "REPEAT:t:81" }] },
    { "name": "landmark over 120", "patches": [{ "path": "comments.0.anchor.landmark", "value": "REPEAT:l:121" }] },
    { "name": "lastRect with a huge value", "patches": [{ "path": "comments.0.anchor.lastRect.width", "value": 10000000 }] },
    { "name": "lastRect with a string", "patches": [{ "path": "comments.0.anchor.lastRect.x", "value": "10" }] },
    { "name": "send.attempts negative", "patches": [{ "path": "comments.0.send.attempts", "value": -1 }] },
    { "name": "send.lastOutcome unknown", "patches": [{ "path": "comments.0.send.lastOutcome", "value": "delivered" }] },
    { "name": "send.maybeSent not boolean", "patches": [{ "path": "comments.0.send.maybeSent", "value": 1 }] },
    { "name": "duplicate comment ids", "patches": [{ "path": "comments.1", "value": "COPY:comments.0" }] },
    { "name": "duplicate ordinals", "patches": [{ "path": "comments.1.ordinal", "value": 2 }] }
  ]
}
