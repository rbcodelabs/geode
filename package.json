{
  "name": "geode",
  "version": "0.5.10",
  "description": "Geode — an open-source knowledge base that works on local Markdown files",
  "main": "dist/main.js",
  "scripts": {
    "test": "vitest run && npm run build && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --mac",
    "release": "npm run build && electron-builder --mac --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "chokidar": "^5.0.0",
    "lucide-static": "^1.31.0",
    "marked": "^18.0.5",
    "moment": "^2.30.1",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.rbcodelabs.geode",
    "productName": "Geode",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "rbcodelabs",
      "repo": "geode",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/index.html",
      "styles/**/*",
      "package.json",
      "resources/**/*",
      "!src/**/*.ts",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
