{
  "title": "Geode hero",
  "target": {
    "type": "electron",
    "app": ".",
    "env": {
      "GEODE_HEADLESS": "0",
      "GEODE_SCREENSHOT_MODE": "1"
    },
    "readySelector": ".nav-file-title[data-path=\"Welcome.md\"]",
    "fixture": {
      "source": "demo/hero-vault"
    },
    "userDataFiles": {
      "geode.json": {
        "recentVaults": [
          "{{fixture}}"
        ],
        "lastVault": "{{fixture}}"
      }
    }
  },
  "environment": {
    "record": {
      "runner": "ssh",
      "host": "dev-builder",
      "remoteDir": "~/product-demo-work",
      "shellInit": "export PATH=\"$HOME/.local/share/fnm:$PATH\"; eval \"$(fnm env)\"",
      "setup": [
        "npm ci",
        "node node_modules/electron/install.js",
        "npm run build"
      ]
    }
  },
  "capture": {
    "width": 1280,
    "height": 800,
    "fps": 30
  },
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "look": {
    "windowWidth": 1440,
    "cornerRadius": 14,
    "dock": true,
    "menuBar": {
      "appName": "Geode",
      "items": [
        "File",
        "Edit",
        "View",
        "Go",
        "Window",
        "Help"
      ],
      "clock": "Sun Oct 11  9:41 AM"
    },
    "appIcon": "resources/icon.png"
  },
  "voice": {
    "provider": "none",
    "modelId": "x",
    "stability": 0.5,
    "similarityBoost": 0.75,
    "style": 0
  },
  "timing": {
    "leadMs": 200,
    "tailMs": 300,
    "maxSlowdown": 1.3
  },
  "scenes": [
    {
      "id": "intro",
      "narration": "which Geode calls a vault. the file explorer. Welcome note.",
      "actions": [
        {
          "type": "waitFor",
          "selector": ".nav-file-title[data-path=\"Welcome.md\"]"
        },
        {
          "type": "pause",
          "ms": 1800
        },
        {
          "type": "hover",
          "selector": ".nav-vault-name",
          "cue": "which Geode calls a vault",
          "optional": true
        },
        {
          "type": "hover",
          "selector": ".nav-file-title[data-path=\"Projects\"], .nav-folder-title[data-path=\"Projects\"]",
          "optional": true,
          "cue": "the file explorer"
        },
        {
          "type": "pause",
          "ms": 600
        },
        {
          "type": "click",
          "selector": ".nav-file-title[data-path=\"Welcome.md\"]",
          "cue": "Welcome note"
        },
        {
          "type": "pause",
          "ms": 2500
        }
      ]
    },
    {
      "id": "new-note",
      "narration": "Press Command N. Type a name. press Enter. start writing.",
      "actions": [
        {
          "type": "pause",
          "ms": 600
        },
        {
          "type": "press",
          "key": "ControlOrMeta+n",
          "label": "⌘ N",
          "cue": "Press Command N"
        },
        {
          "type": "pause",
          "ms": 900
        },
        {
          "type": "type",
          "text": "Meeting Ideas",
          "delayMs": 90,
          "cue": "Type a name"
        },
        {
          "type": "pause",
          "ms": 400
        },
        {
          "type": "press",
          "key": "Enter",
          "cue": "press Enter"
        },
        {
          "type": "pause",
          "ms": 700
        },
        {
          "type": "click",
          "selector": ".workspace-split.mod-root .cm-content",
          "cue": "start writing"
        },
        {
          "type": "type",
          "text": "# Meeting Ideas",
          "delayMs": 70
        },
        {
          "type": "press",
          "key": "Enter"
        },
        {
          "type": "press",
          "key": "Enter"
        },
        {
          "type": "type",
          "text": "Follow up on the roadmap and the ",
          "delayMs": 65
        },
        {
          "type": "pause",
          "ms": 1200
        }
      ]
    },
    {
      "id": "wikilinks",
      "narration": "type two opening square brackets. Pick one and press Enter.",
      "actions": [
        {
          "type": "type",
          "text": "[[Wel",
          "delayMs": 140,
          "cue": "type two opening square brackets"
        },
        {
          "type": "waitFor",
          "selector": ".cm-tooltip-autocomplete",
          "timeoutMs": 6000
        },
        {
          "type": "pause",
          "ms": 1500
        },
        {
          "type": "press",
          "key": "Enter",
          "cue": "Pick one and press Enter"
        },
        {
          "type": "pause",
          "ms": 400
        },
        {
          "type": "type",
          "text": " note.",
          "delayMs": 80
        },
        {
          "type": "pause",
          "ms": 1800
        }
      ]
    },
    {
      "id": "backlinks",
      "narration": "Open the Welcome note. Backlinks panel. Meeting Ideas is listed.",
      "actions": [
        {
          "type": "click",
          "selector": ".nav-file-title[data-path=\"Welcome.md\"]",
          "cue": "Open the Welcome note"
        },
        {
          "type": "pause",
          "ms": 1200
        },
        {
          "type": "click",
          "selector": ".workspace-sidebar.mod-right [data-type=\"backlinks\"]",
          "optional": true,
          "cue": "Backlinks panel"
        },
        {
          "type": "waitFor",
          "selector": ".workspace-sidebar.mod-right .sidebar-view.mod-active .pane-result",
          "timeoutMs": 8000,
          "optional": true
        },
        {
          "type": "hover",
          "selector": ".workspace-sidebar.mod-right .sidebar-view.mod-active .pane-result",
          "optional": true,
          "cue": "Meeting Ideas is listed"
        },
        {
          "type": "pause",
          "ms": 3000
        }
      ]
    },
    {
      "id": "graph",
      "narration": "Command G. Every note is a dot.",
      "actions": [
        {
          "type": "pause",
          "ms": 400
        },
        {
          "type": "press",
          "key": "ControlOrMeta+g",
          "label": "⌘ G",
          "cue": "Command G"
        },
        {
          "type": "waitFor",
          "selector": ".workspace-sidebar.mod-right .graph-view-canvas",
          "timeoutMs": 8000
        },
        {
          "type": "pause",
          "ms": 4500
        },
        {
          "type": "hover",
          "selector": ".workspace-sidebar.mod-right .graph-view-canvas",
          "cue": "Every note is a dot"
        },
        {
          "type": "pause",
          "ms": 3500
        }
      ]
    }
  ]
}